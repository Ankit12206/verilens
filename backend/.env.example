# Environment Variables for VeriLens
# ⚠️ NEVER share this file or commit it to GitHub

# ─── Required ─────────────────────────────────────────────────────────────────
# Get your FREE Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=PASTE_YOUR_NEW_KEY_HERE

# ─── Optional (improves reverse image search accuracy) ────────────────────────
SERPAPI_KEY=

# ─── Optional (Google Fact Check Tools API) ───────────────────────────────────
GOOGLE_FACT_CHECK_API_KEY=

# ─── Server Config ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
